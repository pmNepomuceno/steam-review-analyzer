DATABASE_URL=postgresql+asyncpg://steam:steam@localhost:5433/steam_reviews
# Deploy only: Neon's direct (non-pooled) endpoint, used by alembic. Defaults to DATABASE_URL.
# DATABASE_URL_DIRECT=
MIN_REVIEW_COUNT=200
MAX_REVIEWS=1000
STEAM_REQUEST_DELAY_S=0.5
# Aspect encoder threads (>= 1). Unset: the usable CPUs or the CPU quota rounded up, whichever
# is lower, at most 8.
# ENCODER_THREADS=
# Off in production (render.yaml): unprocessed appids get a 403 listing the processed games.
ALLOW_ON_DEMAND_PROCESSING=true
